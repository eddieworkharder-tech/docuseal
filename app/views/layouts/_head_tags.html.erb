<title><%= turbo_native_app? ? content_for(:native_title) : (content_for(:html_title).presence || (signed_in? ? 'SOVO 智居' : 'SOVO 智居电子签约中心')) %></title>
<%= render 'shared/meta' %>
<style>
  :root[data-theme] {
    --p: 225 72% 53%;
    --pf: 225 72% 43%;
    --pc: 0 0% 100%;
    --s: 47 99% 50%;
    --sf: 47 99% 43%;
    --sc: 225 42% 18%;
    --a: 225 72% 53%;
    --af: 225 72% 43%;
    --ac: 0 0% 100%;
    --n: 225 34% 20%;
    --nf: 225 34% 15%;
    --nc: 0 0% 100%;
    --b1: 220 28% 99%;
    --b2: 220 24% 96%;
    --b3: 220 18% 91%;
    --bc: 225 34% 18%;
    --rounded-box: 0.85rem;
    --rounded-btn: 0.6rem;
    --btn-focus-scale: 1;
    color-scheme: light;
  }
  html, body { background: hsl(220 28% 99%); color: hsl(225 34% 18%); }
  body { min-height: 100vh; }
  .btn-primary, .base-button {
    border-color: #305cde !important;
    background: #305cde !important;
    color: #fff !important;
  }
  .btn-primary:hover, .base-button:hover { background: #244cc6 !important; }
  .btn-accent { border-color: #fec601 !important; background: #fec601 !important; color: #1f2b4d !important; }
  .text-purple-300 { color: #fff !important; }
  a:focus-visible, button:focus-visible, [role="button"]:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: 3px solid #fec601 !important;
    outline-offset: 3px;
  }
  ::selection { background: #fec601; color: #1f2b4d; }
  .sovo-home { max-width: 1200px; margin: 0 auto; padding: clamp(1.5rem, 5vw, 4.5rem) 1rem 4rem; }
  .sovo-home__hero { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(290px, .8fr); gap: clamp(2rem, 7vw, 6rem); align-items: center; }
  .sovo-home__eyebrow { display: inline-flex; align-items: center; gap: .7rem; color: #305cde; font-size: .78rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .sovo-home__eyebrow::before { content: ""; width: 2rem; height: 3px; border-radius: 2px; background: #fec601; }
  .sovo-home h1 { max-width: 12ch; margin: 1.25rem 0 1.15rem; color: #1f2b4d; font-size: clamp(2.7rem, 6.2vw, 5.5rem); font-weight: 760; letter-spacing: -.055em; line-height: 1.04; }
  .sovo-home__lead { max-width: 39rem; color: #53627f; font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.85; }
  .sovo-home__note { display: flex; align-items: flex-start; gap: .8rem; max-width: 40rem; margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid #dce4f2; color: #53627f; font-size: .95rem; line-height: 1.7; }
  .sovo-home__note-mark { flex: 0 0 auto; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: #fff2b8; color: #1f2b4d; font-weight: 800; }
  .sovo-process { position: relative; padding: 2rem clamp(1.4rem, 3vw, 2.35rem); border: 1px solid #dce4f2; border-radius: 1.15rem; background: #fff; box-shadow: 0 18px 55px rgb(31 43 77 / 7%); }
  .sovo-process::before { content: ""; position: absolute; top: 0; left: 2rem; width: 3.2rem; height: 4px; border-radius: 0 0 4px 4px; background: #fec601; }
  .sovo-process h2 { margin: .2rem 0 1.5rem; font-size: 1.25rem; font-weight: 750; letter-spacing: -.02em; }
  .sovo-process ol { display: grid; gap: 1.45rem; }
  .sovo-process li { display: grid; grid-template-columns: 2.25rem 1fr; gap: .9rem; align-items: start; }
  .sovo-process__number { display: grid; place-items: center; width: 2.15rem; height: 2.15rem; border-radius: 50%; background: #edf2ff; color: #305cde; font-size: .78rem; font-weight: 800; }
  .sovo-process strong { display: block; margin: .05rem 0 .2rem; color: #1f2b4d; font-size: 1rem; }
  .sovo-process p { color: #687691; font-size: .88rem; line-height: 1.65; }
  .sovo-home__footer { display: flex; justify-content: space-between; gap: 1rem; margin-top: clamp(3rem, 7vw, 5.5rem); padding-top: 1.2rem; border-top: 1px solid #dce4f2; color: #687691; font-size: .82rem; }
  .sovo-completion { max-width: 760px; margin: clamp(2rem, 7vh, 5rem) auto 4rem; padding: 0 1rem; }
  .sovo-completion__panel { overflow: hidden; border: 1px solid #dce4f2; border-radius: 1.25rem; background: #fff; box-shadow: 0 20px 60px rgb(31 43 77 / 8%); }
  .sovo-completion__brand { padding: 1.5rem 2rem; border-bottom: 1px solid #e7ecf5; }
  .sovo-completion__body { padding: clamp(1.5rem, 5vw, 3rem); }
  .sovo-completion__mark { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; margin-bottom: 1.4rem; border-radius: 50%; background: #e8f5ec; color: #20764a; font-size: 1.75rem; font-weight: 800; }
  .sovo-completion__eyebrow { margin-bottom: .5rem; color: #20764a; font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .sovo-completion h1 { margin: 0; color: #1f2b4d; font-size: clamp(2rem, 5vw, 3rem); font-weight: 760; letter-spacing: -.045em; line-height: 1.12; }
  .sovo-completion__intro { margin-top: .9rem; color: #53627f; font-size: 1.03rem; line-height: 1.75; }
  .sovo-completion__document { margin: 1.8rem 0; padding: 1.15rem 1.25rem; border: 1px solid #e1e8f4; border-radius: .85rem; background: #f7f9fd; }
  .sovo-completion__document-label { margin-bottom: .35rem; color: #6b7892; font-size: .75rem; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .sovo-completion__document-name { color: #1f2b4d; font-size: 1.05rem; font-weight: 700; line-height: 1.55; overflow-wrap: anywhere; }
  .sovo-completion__actions { display: grid; gap: .75rem; margin-top: 1.5rem; }
  .sovo-completion__actions .base-button, .sovo-completion__actions .white-button { min-height: 3.25rem; border-radius: .65rem; font-weight: 700; }
  .sovo-completion__receipt { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid #e7ecf5; color: #53627f; font-size: .88rem; line-height: 1.7; }
  .sovo-completion__pending { margin-top: 1.3rem; padding: 1rem 1.1rem; border-radius: .75rem; background: #fff8da; color: #594800; font-size: .9rem; line-height: 1.7; }
  @media (max-width: 760px) {
    .sovo-home { padding-top: 2.5rem; }
    .sovo-home__hero { grid-template-columns: 1fr; gap: 2.5rem; }
    .sovo-home h1 { max-width: 11ch; }
    .sovo-home__footer { flex-direction: column; }
  }
</style>
<% if turbo_native_app? %>
  <meta name="turbo-cache-control" content="no-preview">
  <%= render 'layouts/native_styles' %>
<% end %>
