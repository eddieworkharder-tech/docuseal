<% content_for(:html_title, 'Electronic Records and Signatures Disclosure | Sagepaths') %>
<% content_for(:html_description, 'Electronic Records and Signatures Disclosure for Sagepaths electronic signing service.') %>
<style>
  body {
    background: #0b1326;
    background: radial-gradient(circle at 50% 15%, #142247 0%, #0a1122 100%);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #172445;
    margin: 0;
  }
  .sovo-ersd-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 32px 16px;
    box-sizing: border-box;
  }
  .sovo-ersd-card {
    width: min(100%, 780px);
    background: #ffffff;
    color: #172445;
    border-radius: 16px;
    border: 1px solid #dbe6f8;
    border-top: 4px solid #305cde;
    padding: clamp(24px, 5vw, 44px);
    box-shadow: 0 24px 80px rgba(10, 17, 36, 0.45);
    box-sizing: border-box;
  }
  .sovo-ersd-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e4ecfa;
  }
  .sovo-ersd-brand img {
    height: 34px;
    width: auto;
    max-width: 170px;
    display: block;
  }
  .sovo-ersd-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: #edf3fe;
    color: #305cde;
    border: 1px solid #cce0fc;
    border-radius: 20px;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
  }
  .sovo-ersd-badge::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fec601;
  }
  .sovo-ersd-title {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    font-weight: 700;
    color: #0d1730;
    line-height: 1.25;
    margin: 0 0 8px 0;
  }
  .sovo-ersd-subtitle {
    color: #516287;
    font-size: 0.96rem;
    line-height: 1.5;
    margin: 0 0 24px 0;
  }

  /* Collapsible Accordion */
  .sovo-ersd-accordion {
    border: 1px solid #d4e2f8;
    border-radius: 12px;
    background: #f7faff;
    margin-bottom: 24px;
    overflow: hidden;
    transition: all 0.2s ease;
  }
  .sovo-ersd-accordion[open] {
    background: #ffffff;
    box-shadow: 0 4px 20px rgba(48, 92, 222, 0.08);
    border-color: #305cde;
  }
  .sovo-ersd-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-weight: 600;
    color: #0d1730;
    transition: background 0.15s ease;
  }
  .sovo-ersd-summary::-webkit-details-marker {
    display: none;
  }
  .sovo-ersd-summary:hover {
    background: #edf3fe;
  }
  .sovo-summary-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sovo-summary-icon {
    width: 20px;
    height: 20px;
    color: #305cde;
    flex-shrink: 0;
  }
  .sovo-summary-text {
    font-size: 0.98rem;
    font-weight: 600;
    color: #0d1730;
  }
  .sovo-summary-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sovo-summary-hint {
    font-size: 0.82rem;
    font-weight: 500;
    color: #516287;
  }
  .sovo-summary-chevron {
    width: 18px;
    height: 18px;
    color: #305cde;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }
  .sovo-ersd-accordion[open] .sovo-summary-chevron {
    transform: rotate(180deg);
  }

  /* Reading Content Box */
  .sovo-ersd-reading {
    border-top: 1px solid #e1ecfa;
    max-height: min(48vh, 440px);
    overflow-y: auto;
    padding: 20px 22px;
    background: #ffffff;
    line-height: 1.65;
    color: #243354;
    font-size: 0.92rem;
  }
  .sovo-ersd-reading h2 {
    font-size: 1.02rem;
    font-weight: 700;
    color: #0d1730;
    margin: 1.25rem 0 .4rem;
  }
  .sovo-ersd-reading h2:first-child {
    margin-top: 0;
  }
  .sovo-ersd-reading p {
    margin: .35rem 0 .8rem;
  }
  .sovo-ersd-reading a {
    color: #305cde;
    text-decoration: underline;
    font-weight: 600;
  }
  .sovo-ersd-reading a:hover {
    color: #1e40af;
  }

  /* Checkbox & Submission Button */
  .sovo-ersd-accept-label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 20px 0;
    cursor: pointer;
  }
  .sovo-ersd-checkbox {
    width: 22px;
    height: 22px;
    accent-color: #305cde;
    flex: 0 0 auto;
    margin-top: 2px;
    cursor: pointer;
  }
  .sovo-ersd-accept-text {
    font-size: 0.96rem;
    font-weight: 600;
    color: #0d1730;
    line-height: 1.45;
  }
  .sovo-ersd-continue {
    width: 100%;
    min-height: 52px;
    font-size: 1.05rem;
    font-weight: 700;
    background: #fec601;
    color: #0b1532;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(254, 198, 1, 0.45);
    transition: transform 0.15s ease, opacity 0.2s ease, box-shadow 0.15s ease;
  }
  .sovo-ersd-continue:hover:not(:disabled) {
    transform: translateY(-1px);
    background: #ffd024;
    box-shadow: 0 6px 20px rgba(254, 198, 1, 0.55);
  }
  .sovo-ersd-continue:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }
  .sovo-ersd-footer {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid #e4ecfa;
    color: #516287;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .sovo-ersd-footer a {
    color: #305cde;
    text-decoration: underline;
    font-weight: 600;
  }
  .sovo-ersd-footer a:hover {
    color: #1e40af;
  }
  .sovo-ersd-copyright {
    margin-top: 8px;
    font-size: 0.84rem;
    color: #7685a6;
  }

  @media (max-width: 640px) {
    .sovo-ersd-shell { padding: 12px; }
    .sovo-ersd-card { border-radius: 12px; padding: 22px 18px; }
    .sovo-summary-hint { display: none; }
    .sovo-ersd-reading { max-height: 42vh; padding: 16px; }
  }
</style>

<div class="sovo-ersd-shell">
  <main class="sovo-ersd-card" aria-labelledby="sovo-ersd-title">
    <div class="sovo-ersd-topbar">
      <div class="sovo-ersd-brand">
        <%= image_tag '/sovo-logo.png', alt: 'SOVO', style: 'height: 34px; width: auto; max-width: 170px; display: block;' %>
      </div>
      <span class="sovo-ersd-badge">Disclosure</span>
    </div>

    <h1 id="sovo-ersd-title" class="sovo-ersd-title">
      Electronic Records and Signatures Disclosure
    </h1>
    <p class="sovo-ersd-subtitle">
      Please review and accept the disclosure below to proceed with your agreement.
    </p>

    <details class="sovo-ersd-accordion">
      <summary class="sovo-ersd-summary">
        <div class="sovo-summary-left">
          <svg class="sovo-summary-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span class="sovo-summary-text">View Full Terms & Legal Disclosure</span>
        </div>
        <div class="sovo-summary-right">
          <span class="sovo-summary-hint">Click to expand / collapse</span>
          <svg class="sovo-summary-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </summary>

      <section class="sovo-ersd-reading" aria-label="Electronic records and signature disclosure">
        <h2>ELECTRONIC RECORDS AND SIGNATURES DISCLOSURE</h2>
        <p>From time to time, Sagepaths ("we", "us" or "Company") may be required by law to provide you with certain written notices or disclosures. This disclosure explains the terms for providing those notices and disclosures electronically through the Sagepaths electronic signing service. Please read this disclosure carefully. If you are able to access this information electronically and agree to these terms, please confirm your acceptance using the checkbox below before proceeding to sign your agreement.</p>

        <h2>Getting paper copies</h2>
        <p>You may request a paper copy of any record that we provide or make available electronically. You may download and print the documents during and immediately following your signing session. Should you require paper copies at a later date, please contact us by email at <a href="mailto:eddie.tang@sagepaths.com">eddie.tang@sagepaths.com</a>. No administrative or copying fee is currently charged for paper copies.</p>

        <h2>Withdrawing your consent</h2>
        <p>You have the right to withdraw your consent to receive required notices and disclosures electronically. To withdraw your consent, please email <a href="mailto:eddie.tang@sagepaths.com">eddie.tang@sagepaths.com</a> stating your full name, email address, postal address and telephone number. You may also decline to continue signing electronically and contact us directly to withdraw your consent.</p>

        <h2>Consequences of withdrawing consent</h2>
        <p>If you choose to receive notices and disclosures in paper format, processing times may be extended as documents must be dispatched by post and await your physical acknowledgement. You will no longer be able to use the Sagepaths electronic signing service to complete agreements online.</p>

        <h2>Electronic delivery of notices and disclosures</h2>
        <p>Unless you notify us otherwise in accordance with the procedures set out herein, Sagepaths will provide electronically all notices, disclosures, authorisations, acknowledgements and other contract documents required during our relationship with you. We will deliver these via the email address you have provided. If you do not agree, please contact us prior to signing.</p>

        <h2>How to contact Sagepaths</h2>
        <p>If you have any questions regarding your contract, wish to update your contact details, request paper copies, or withdraw your consent, please contact us at <a href="mailto:eddie.tang@sagepaths.com">eddie.tang@sagepaths.com</a>.</p>

        <h2>Updating your contact details</h2>
        <p>To update your registered email address or contact details, please email <a href="mailto:eddie.tang@sagepaths.com">eddie.tang@sagepaths.com</a> detailing your previous email address and new contact details.</p>

        <h2>Required hardware and software</h2>
        <p>To view and retain electronic records, you require access to the internet and an up-to-date web browser capable of viewing and downloading PDF documents. If you experience technical difficulties, please contact us prior to continuing.</p>

        <h2>Acknowledging access and consent</h2>
        <p>By ticking the checkbox below, you confirm that: (1) you have access to hardware and software meeting the requirements specified above; (2) you are able to read and retain this disclosure; and (3) you consent to receive electronically all notices, disclosures, authorisations, acknowledgements and agreements that Sagepaths is required to provide.</p>

        <h2>Right of final interpretation</h2>
        <p>Sagepaths reserves all rights of final interpretation regarding this disclosure, contract terms, and electronic signature procedures.</p>
      </section>
    </details>

    <%= form_with url: submit_form_path(@submitter.slug), method: :patch, local: true, id: 'sovo-ersd-form', data: { turbo: false } do |form| %>
      <label class="sovo-ersd-accept-label" for="sovo-ersd-accept">
        <input id="sovo-ersd-accept" class="sovo-ersd-checkbox" name="sovo_ersd_accept" type="checkbox" value="1" required>
        <span class="sovo-ersd-accept-text">
          I have read and agree to the Electronic Records and Signatures Disclosure.
        </span>
      </label>

      <div style="margin-top: 20px;">
      <button id="sovo-ersd-continue" class="sovo-ersd-continue" type="submit" disabled>
          Agree & Proceed to Sign
        </button>
      </div>
      <p id="sovo-ersd-error" class="text-red-700 mt-3" role="alert" hidden></p>
    <% end %>

    <div class="sovo-ersd-footer">
      <p>If you have any questions regarding your contract or this disclosure, please contact <a href="mailto:eddie.tang@sagepaths.com">eddie.tang@sagepaths.com</a>.</p>
      <p class="sovo-ersd-copyright">Sagepaths reserves all rights of final interpretation.</p>
    </div>
  </main>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  (() => {
    const form = document.getElementById('sovo-ersd-form')
    const checkbox = document.getElementById('sovo-ersd-accept')
    const button = document.getElementById('sovo-ersd-continue')

    if (!form || !checkbox || !button) return

    button.disabled = !checkbox.checked

    checkbox.addEventListener('change', () => {
      button.disabled = !checkbox.checked
    })

    form.addEventListener('submit', (e) => {
      if (!checkbox.checked) {
        e.preventDefault()
        return
      }
      setTimeout(() => {
        button.disabled = true
        button.style.opacity = '0.7'
        button.style.pointerEvents = 'none'
      }, 0)
      button.textContent = 'Entering Signing Session...'
    })
  })()
</script>
