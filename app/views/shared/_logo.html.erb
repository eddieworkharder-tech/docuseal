<% requested_width = local_assigns[:width].to_s.gsub(/[^0-9.]/, '').to_f %>
<% logo_width = [requested_width, 140].max.to_i %>
<%= image_tag '/sovo-logo.png', alt: 'SOVO 智居', width: logo_width, class: local_assigns[:class], style: "display:block;width:#{logo_width}px;height:auto;max-width:100%;" %>
